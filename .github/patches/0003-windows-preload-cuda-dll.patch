--- a/faiss/python/__init__.py
+++ b/faiss/python/__init__.py
@@ -30,6 +30,35 @@
 
     import ctypes
     import os
+
+    if sys.platform == "win32":
+        # Windows: the CUDA runtime DLLs are named cudart64_12.dll /
+        # cublas64_12.dll / curand64_10.dll and live either in the CUDA Toolkit
+        # (CUDA_PATH\bin) or in the nvidia-*-cu* wheels
+        # (site-packages/nvidia/<pkg>/bin, site-packages/nvidia/cu13/bin).
+        # Register every directory we can find with the DLL loader and never
+        # raise: a plain PATH entry is a valid setup as well.
+        _dirs = []
+        for _pkg in ("cuda_runtime", "cublas", "curand", "nvjitlink", "cu13"):
+            try:
+                _mod = __import__("nvidia." + _pkg, fromlist=["*"])
+            except ImportError:
+                continue
+            for _root in list(getattr(_mod, "__path__", [])):
+                for _sub in ("bin", os.path.join("bin", "x64"), "lib"):
+                    _dirs.append(os.path.join(_root, _sub))
+        for _env in ("FAISS_CUDA_PATH", "CUDA_PATH", "CUDA_HOME", "CUDA_ROOT"):
+            _root = os.environ.get(_env)
+            if _root:
+                _dirs.append(_root if _root.lower().endswith("bin")
+                             else os.path.join(_root, "bin"))
+        for _dir in _dirs:
+            if os.path.isdir(_dir):
+                try:
+                    os.add_dll_directory(_dir)
+                except (AttributeError, OSError):
+                    pass
+        return
 
     def _load(path):
         """dlopen one .so with global visibility, or raise a fix-it."""
